[Unit]
Description=Shumeyko Analytics Test Web API
After=network-online.target postgresql@16-main.service
Wants=network-online.target
Requires=postgresql@16-main.service
RequiresMountsFor=/data/shumeyko/test

[Service]
Type=simple
User=shumeyko-test
Group=shumeyko-test
UMask=0027
WorkingDirectory=/opt/shumeyko-runtime/test/current
EnvironmentFile=/etc/shumeiko-web-test.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/shumeyko-runtime/test/current/src
Environment=SHUMEYKO_RUNTIME_ENVIRONMENT=test
Environment=SHUMEYKO_SESSION_COOKIE_NAME=shumeyko_test_session
Environment=SHUMEYKO_CLIENT_LOGIN_ENABLED=false
Environment=SHUMEYKO_EXTERNAL_INTEGRATIONS_ENABLED=false
Environment=SHUMEYKO_ALLOWED_EXPORT_ROOT=/data/shumeyko/test/reports
Environment=SHUMEYKO_DEFAULT_REPORT_WORKBOOK=/data/shumeyko/test/reports/none.xlsx
Environment=SHUMEYKO_SOURCE_REFRESH_ROOT=/data/shumeyko/test/source_refresh
ExecStart=/usr/bin/env SHUMEYKO_RUNTIME_ENVIRONMENT=test SHUMEYKO_SESSION_COOKIE_NAME=shumeyko_test_session SHUMEYKO_CLIENT_LOGIN_ENABLED=false SHUMEYKO_EXTERNAL_INTEGRATIONS_ENABLED=false SHUMEYKO_ALLOWED_EXPORT_ROOT=/data/shumeyko/test/reports SHUMEYKO_DEFAULT_REPORT_WORKBOOK=/data/shumeyko/test/reports/none.xlsx SHUMEYKO_SOURCE_REFRESH_ROOT=/data/shumeyko/test/source_refresh /opt/shumeyko-runtime/test/current/.venv/bin/python -m uvicorn wb_unit_economics.web.app:app --host 127.0.0.1 --port 8098 --workers 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
MemoryMax=2G
NoNewPrivileges=true
CapabilityBoundingSet=
RestrictSUIDSGID=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data/shumeyko/test
InaccessiblePaths=/data/shumeyko/source_refresh /data/shumeyko/prod/reports /opt/shumeyko-partners-wb-unit-economics/reports /var/backups/shumeiko-web

[Install]
WantedBy=multi-user.target

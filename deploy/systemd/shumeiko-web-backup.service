[Unit]
Description=Backup Shumeyko Web Cabinet PostgreSQL database
After=network-online.target postgresql@16-main.service
Wants=network-online.target
RequiresMountsFor=/var/backups

[Service]
Type=oneshot
WorkingDirectory=/opt/shumeyko-partners-wb-unit-economics
EnvironmentFile=/etc/shumeiko-web-prod.env
ExecStart=/opt/shumeyko-partners-wb-unit-economics/.venv/bin/python scripts/backup_web_db.py --output-dir /var/backups/shumeiko-web --keep-latest 1
NoNewPrivileges=true
PrivateTmp=true

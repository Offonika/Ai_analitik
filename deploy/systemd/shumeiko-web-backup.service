[Unit]
Description=Backup Shumeyko Web Cabinet PostgreSQL database
After=network-online.target postgresql@16-main.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/shumeyko-runtime/prod/current
EnvironmentFile=/etc/shumeiko-web-prod.env
ExecStart=/opt/shumeyko-runtime/prod/current/.venv/bin/python scripts/backup_web_db.py --output-dir /var/backups/shumeiko-web --retention-days 1
NoNewPrivileges=true
PrivateTmp=true

[Unit]
Description=Backup Shumeyko Web Cabinet PostgreSQL database
After=network-online.target postgresql@16-main.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/shumeyko-partners-wb-unit-economics
EnvironmentFile=/etc/shumeiko-web.env
ExecStart=/opt/shumeyko-partners-wb-unit-economics/.venv/bin/python scripts/backup_web_db.py --output-dir /var/backups/shumeiko-web --retention-days 3
NoNewPrivileges=true
PrivateTmp=true


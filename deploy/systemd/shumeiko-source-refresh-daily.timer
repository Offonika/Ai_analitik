[Unit]
Description=Run Shumeyko rolling daily source refresh outside the weekly slot

[Timer]
OnCalendar=Mon *-*-* *:15:00
OnCalendar=Tue *-*-* 00..05:15:00
OnCalendar=Tue *-*-* 07..23:15:00
OnCalendar=Wed..Sun *-*-* *:15:00
Persistent=true
Unit=shumeiko-source-refresh-daily.service

[Install]
WantedBy=timers.target

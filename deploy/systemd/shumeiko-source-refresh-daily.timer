[Unit]
Description=Run Shumeyko rolling daily source refresh during the 1C daytime window

[Timer]
OnCalendar=Mon *-*-* 08..22:15:00
OnCalendar=Tue *-*-* 08:15:00
OnCalendar=Tue *-*-* 10..22:15:00
OnCalendar=Wed..Sun *-*-* 08..22:15:00
Persistent=true
Unit=shumeiko-source-refresh-daily.service

[Install]
WantedBy=timers.target

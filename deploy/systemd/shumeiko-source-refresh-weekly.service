[Unit]
Description=Shumeyko WB/1C weekly full source refresh
After=network-online.target postgresql@16-main.service shumeiko-web-prod.service
Wants=network-online.target
RequiresMountsFor=/data/shumeyko/source_refresh /opt/shumeyko-partners-wb-unit-economics/reports

[Service]
Type=oneshot
WorkingDirectory=/opt/shumeyko-runtime/prod/current
EnvironmentFile=/etc/shumeiko-web-prod.env
Environment=SHUMEYKO_SOURCE_REFRESH_TENANT=shumeyko
Environment=SHUMEYKO_SOURCE_REFRESH_MIN_FREE_GB=20
ExecStart=/opt/shumeyko-runtime/prod/current/.venv/bin/python scripts/run_source_refresh.py --tenant ${SHUMEYKO_SOURCE_REFRESH_TENANT} --mode full --reason "systemd weekly full source refresh"
MemoryHigh=512M
MemoryMax=1G
MemorySwapMax=256M
OOMScoreAdjust=300
TasksMax=128
NoNewPrivileges=true
PrivateTmp=true

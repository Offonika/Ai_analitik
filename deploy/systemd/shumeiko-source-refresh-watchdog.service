[Unit]
Description=Shumeyko source refresh worker watchdog
After=postgresql@16-main.service
Requires=postgresql@16-main.service
RequiresMountsFor=/data/shumeyko/source_refresh

[Service]
Type=oneshot
WorkingDirectory=/opt/shumeyko-runtime/prod/current
EnvironmentFile=/etc/shumeiko-web-prod.env
ExecStart=/opt/shumeyko-runtime/prod/current/.venv/bin/python scripts/check_source_refresh_worker.py --apply
NoNewPrivileges=true
PrivateTmp=true

[Unit]
Description=Shumeyko source refresh worker watchdog
After=postgresql@16-main.service
Requires=postgresql@16-main.service

[Service]
Type=oneshot
WorkingDirectory=/opt/shumeyko-partners-wb-unit-economics
EnvironmentFile=/etc/shumeiko-web.env
ExecStart=/opt/shumeyko-partners-wb-unit-economics/.venv/bin/python scripts/check_source_refresh_worker.py --apply
NoNewPrivileges=true
PrivateTmp=true

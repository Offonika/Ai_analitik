[Unit]
Description=Shumeyko source refresh worker %i
After=network-online.target postgresql@16-main.service
Wants=network-online.target
Requires=postgresql@16-main.service
RequiresMountsFor=/data/shumeyko/source_refresh /data/shumeyko/prod/reports

[Service]
Type=exec
WorkingDirectory=/opt/shumeyko-runtime/prod/current
EnvironmentFile=/etc/shumeiko-web-prod.env
Environment=SHUMEYKO_DB_FIRST_REPORTS_ENABLED=true
Environment=SHUMEYKO_ALLOWED_EXPORT_ROOT=/data/shumeyko/prod/reports
Environment=SHUMEYKO_DEFAULT_REPORT_WORKBOOK=/data/shumeyko/prod/reports/shumeyko_wb_excel_mvp.xlsx
Environment=SHUMEYKO_SOURCE_REFRESH_ROOT=/data/shumeyko/source_refresh
Environment=SHUMEYKO_SOURCE_REFRESH_MIN_FREE_GB=20
ExecStart=/usr/bin/env SHUMEYKO_ALLOWED_EXPORT_ROOT=/data/shumeyko/prod/reports SHUMEYKO_DEFAULT_REPORT_WORKBOOK=/data/shumeyko/prod/reports/shumeyko_wb_excel_mvp.xlsx SHUMEYKO_SOURCE_REFRESH_ROOT=/data/shumeyko/source_refresh SHUMEYKO_SOURCE_REFRESH_MIN_FREE_GB=20 SHUMEYKO_SOURCE_REFRESH_ONEC_MAX_PAGES=1000 /opt/shumeyko-runtime/prod/current/.venv/bin/python scripts/run_source_refresh_worker.py --run-id %i --worker-id systemd:%i --once
ExecStopPost=/opt/shumeyko-runtime/prod/current/.venv/bin/python scripts/repair_source_refresh_run.py --run-id %i --failure-code worker_interrupted --apply
RuntimeMaxSec=2h
TimeoutStopSec=60
MemoryHigh=3G
MemoryMax=4G
MemorySwapMax=1G
ManagedOOMSwap=kill
ManagedOOMMemoryPressure=auto
OOMScoreAdjust=500
OOMPolicy=stop
TasksMax=256
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true

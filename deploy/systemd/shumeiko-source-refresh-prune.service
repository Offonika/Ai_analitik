[Unit]
Description=Prune old Shumeyko source refresh snapshots
After=network-online.target postgresql@16-main.service
Wants=network-online.target
RequiresMountsFor=/data/shumeyko/source_refresh
ConditionPathIsDirectory=/data/shumeyko/source_refresh

[Service]
Type=oneshot
WorkingDirectory=/opt/shumeyko-runtime/prod/current
EnvironmentFile=/etc/shumeiko-web-prod.env
ExecStart=/opt/shumeyko-runtime/prod/current/.venv/bin/python scripts/prune_source_refresh.py --source-root /data/shumeyko/source_refresh --daily-keep 3 --full-keep 2 --apply
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true

[Unit]
Description=Shumeyko WB/1C daily source refresh
After=network-online.target postgresql@16-main.service shumeiko-web-prod.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/shumeyko-runtime/prod/current
EnvironmentFile=/etc/shumeiko-web-prod.env
Environment=SHUMEYKO_SOURCE_REFRESH_TENANT=shumeyko
ExecStart=/opt/shumeyko-runtime/prod/current/.venv/bin/python scripts/run_source_refresh.py --tenant ${SHUMEYKO_SOURCE_REFRESH_TENANT} --mode daily --reason "systemd daily source refresh"
MemoryHigh=512M
MemoryMax=1G
MemorySwapMax=256M
OOMScoreAdjust=300
TasksMax=128
NoNewPrivileges=true
PrivateTmp=true

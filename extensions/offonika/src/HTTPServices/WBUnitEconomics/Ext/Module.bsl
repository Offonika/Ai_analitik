#Область СлужебныеФункции

Функция МетаданныеМаркетплейсаДоступны()

	Если Не МетаданныеОбъектСуществует(Метаданные.РегистрыСведений, "ИС_WB_СоответствиеРазмеров") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Не МетаданныеОбъектСуществует(Метаданные.РегистрыСведений, "ИС_WB_ШтрихкодыРазмеров") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Не МетаданныеОбъектСуществует(Метаданные.Справочники, "ИС_WB_РазмерыНоменклатур") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Не МетаданныеОбъектСуществует(Метаданные.Справочники, "ИС_WB_Номенклатура") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Не МетаданныеОбъектСуществует(Метаданные.Справочники, "Номенклатура") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Не МетаданныеОбъектСуществует(Метаданные.Справочники, "ХарактеристикиНоменклатуры") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция МетаданныеOzonДоступны()

	Если Не МетаданныеОбъектСуществует(Метаданные.РегистрыСведений, "ИС_Ozon_СоответствиеХарактеристик") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Не МетаданныеОбъектСуществует(Метаданные.Справочники, "ИС_Ozon_Номенклатура") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Не МетаданныеОбъектСуществует(Метаданные.Справочники, "Номенклатура") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Не МетаданныеОбъектСуществует(Метаданные.Справочники, "ХарактеристикиНоменклатуры") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция ДоступныеМаркетплейсы()

	Результат = Новый Массив;

	Если МетаданныеМаркетплейсаДоступны() Тогда
		Результат.Добавить("wb");
	КонецЕсли;

	Если МетаданныеOzonДоступны() Тогда
		Результат.Добавить("ozon");
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция МетаданныеОбъектСуществует(КоллекцияМетаданных, ИмяОбъекта)

	Попытка
		Возврат КоллекцияМетаданных.Найти(ИмяОбъекта) <> Неопределено;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция ЛимитИзЗапроса(Запрос, ЛимитПоУмолчанию)

	Лимит = ЛимитПоУмолчанию;

	Попытка
		ЗначениеЛимита = Запрос.ПараметрыЗапроса.Получить("limit");
	Исключение
		ЗначениеЛимита = Неопределено;
	КонецПопытки;

	Если ЗначениеЗаполнено(ЗначениеЛимита) Тогда
		Попытка
			Лимит = Число(ЗначениеЛимита);
		Исключение
			Лимит = ЛимитПоУмолчанию;
		КонецПопытки;
	КонецЕсли;

	Если Лимит < 1 Тогда
		Лимит = ЛимитПоУмолчанию;
	КонецЕсли;

	Если Лимит > 50000 Тогда
		Лимит = 50000;
	КонецЕсли;

	Возврат Лимит;

КонецФункции

Функция МаркетплейсИзЗапроса(Запрос)

	Попытка
		ЗначениеМаркетплейса = Запрос.ПараметрыЗапроса.Получить("marketplace");
	Исключение
		ЗначениеМаркетплейса = "";
	КонецПопытки;

	Если ЗначениеМаркетплейса = Неопределено Или ЗначениеМаркетплейса = Null Тогда
		Возврат "wb";
	КонецЕсли;

	Маркетплейс = НРег(СокрЛП(Строка(ЗначениеМаркетплейса)));
	Если Маркетплейс = "ozon" Или Маркетплейс = "озон" Тогда
		Возврат "ozon";
	КонецЕсли;

	Возврат "wb";

КонецФункции

Функция JsonОтвет(КодСостояния, Данные)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Тело = ЗаписьJSON.Закрыть();

	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.Заголовки.Вставить("Cache-Control", "no-store");
	Ответ.УстановитьТелоИзСтроки(
		Тело,
		КодировкаТекста.UTF8,
		ИспользованиеByteOrderMark.НеИспользовать
	);

	Возврат Ответ;

КонецФункции

Функция ОшибкаJson(КодСостояния, КодОшибки)

	Данные = Новый Структура;
	Данные.Вставить("schema_version", "1");
	Данные.Вставить("source", "1c_marketplace_http");
	Данные.Вставить("status", "error");
	Данные.Вставить("error", КодОшибки);
	Данные.Вставить("generated_at", ФорматДатаJSON(ТекущаяДатаСеанса()));

	Возврат JsonОтвет(КодСостояния, Данные);

КонецФункции

Функция СтатусСопоставления(Номенклатура1С)

	Если ЗначениеЗаполнено(Номенклатура1С) Тогда
		Возврат "matched";
	КонецЕсли;

	Возврат "missing";

КонецФункции

Функция СсылкаКлюч(Значение)

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Возврат Строка(Значение.УникальныйИдентификатор());
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

Функция СтрокаИлиПусто(Значение)

	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(Строка(Значение));

КонецФункции

Функция ЧислоИлиNull(Значение)

	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат Null;
	КонецЕсли;

	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат Null;
	КонецПопытки;

КонецФункции

Функция ФорматДатаJSON(ДатаЗначение)

	Возврат Формат(ДатаЗначение, "ДФ=yyyy-MM-ddTHH:mm:ss") + "+03:00";

КонецФункции

#КонецОбласти
